extends ../../layouts/default.pug

block main
  if !laGiaoVien
    .alert.alert-info.small
      | Tài khoản này không gắn với hồ sơ giáo viên nên đang xem toàn bộ phân công của hệ thống.
      |  Đăng nhập bằng tài khoản giáo viên để xem đúng nhiệm vụ được giao.

  .card
    .card-header Danh sách HSSV được phân công hướng dẫn (#{rows.length})
    .table-responsive
      table.table.table-hover.mb-0
        thead
          tr
            th.text-center(style="width:50px") STT
            th Mã HSSV
            th Họ và tên
            th Đợt thực tập
            th Doanh nghiệp
            th Vị trí thực tập
            th.text-center Nhật ký
            th.text-center Kết quả
            th.text-end Thao tác
        tbody
          if rows.length === 0
            tr
              td.text-center.text-muted(colspan="9") Chưa có HSSV nào được phân công cho bạn.
          each row, i in rows
            tr
              td.text-center= i + 1
              td= row.phanCong.hocSinh_id ? row.phanCong.hocSinh_id.code : ""
              td= row.phanCong.hocSinh_id ? row.phanCong.hocSinh_id.fullName : ""
              td= row.phanCong.dotThucTap_id ? row.phanCong.dotThucTap_id.name : ""
              td= row.phanCong.doanhNghiep_id ? row.phanCong.doanhNghiep_id.name : ""
              td= row.phanCong.viTriThucTap
              td.text-center
                span.badge(class=row.soNhatKy > 0 ? "bg-primary" : "bg-secondary") #{row.soNhatKy} tuần
              td.text-center
                if row.danhGia && row.danhGia.diemTongKet !== null
                  strong= row.danhGia.diemTongKet
                  |  (#{row.danhGia.xepLoai})
                else
                  span.text-muted Chưa đánh giá
              td.text-end.text-nowrap
                a.btn.btn-sm.btn-outline-secondary(href=`${prefixAdmin}/nhat-ky/${row.phanCong.id}`) Nhật ký
                a.btn.btn-sm.btn-outline-primary.ms-1(href=`${prefixAdmin}/danh-gia/nhap/${row.phanCong.id}`) Đánh giá
