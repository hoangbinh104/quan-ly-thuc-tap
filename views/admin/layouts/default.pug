      include ../partials/sidebar.pug
      .layout__main
        include ../partials/header.pug
        main.p-4
          include ../partials/alert.pug
          block main
    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js")
    script(src="/js/main.js")
